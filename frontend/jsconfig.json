{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/components/*": ["src/components/*"],
      "@/pages/*": ["src/components/pages/*"],
      "@/common/*": ["src/components/common/*"],
      "@/styles/*": ["src/styles/*"],
      "@/utils/*": ["src/utils/*"],
      "@/store/*": ["src/redux/*"],
      "@/assets/*": ["public/*"],
      "@/hooks/*": ["src/hooks/*"],
      "@/stubs/*": ["src/stubs/*"]
    }
  },
  "include": ["src"]
}
